    <script>
        
        // Tab Switcher Logic
        function switchTab(tabName) {
            // Hide all tab contents
            const contents = document.querySelectorAll('.tab-content');
            contents.forEach(el => el.classList.add('hidden'));

            // Show selected tab content
            const targetContent = document.getElementById('content-' + tabName);
            if (targetContent) {
                targetContent.classList.remove('hidden');
            }

            // Update main navbar styles
            const navButtons = document.querySelectorAll('.tab-btn');
            navButtons.forEach(btn => {
                btn.classList.remove('text-brand-400', 'bg-brand-500/10', 'border', 'border-brand-500/20');
                btn.classList.add('text-gray-300');
            });
            const activeNav = document.getElementById('nav-' + tabName);
            if (activeNav) {
                activeNav.classList.add('text-brand-400', 'bg-brand-500/10', 'border', 'border-brand-500/20');
                activeNav.classList.remove('text-gray-300');
            }

            // Update subnav buttons styles
            const subBtns = document.querySelectorAll('.subtab-btn');
            subBtns.forEach(btn => {
                btn.classList.remove('bg-brand-500', 'text-gray-950', 'shadow-md', 'font-bold');
                btn.classList.add('text-gray-400', 'font-medium');
            });
            const activeSub = document.getElementById('sub-' + tabName);
            if (activeSub) {
                activeSub.classList.add('bg-brand-500', 'text-gray-950', 'shadow-md', 'font-bold');
                activeSub.classList.remove('text-gray-400', 'font-medium');
            }

            // Close mobile menu if open
            document.getElementById('mobile-menu').classList.add('hidden');

            // Scroll to top of tab container smooth
            window.scrollTo({ top: 320, behavior: 'smooth' });
        }

        // Toggle Mobile Navigation
        document.getElementById('mobile-menu-btn').addEventListener('click', function() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        });

        // FAQ Accordion Toggle
        function toggleFaq(button) {
            const card = button.closest('.faq-card');
            const content = card.querySelector('.faq-content');
            const icon = card.querySelector('.faq-icon');

            const isHidden = content.classList.contains('hidden');

            if (isHidden) {
                content.classList.remove('hidden');
                icon.classList.add('rotate-180');
            } else {
                content.classList.add('hidden');
                icon.classList.remove('rotate-180');
            }
        }

        // Global Live Filter Function
        function filterContent() {
            const query = document.getElementById('global-search').value.toLowerCase().trim();
            const searchableItems = document.querySelectorAll('.searchable-item');

            searchableItems.forEach(item => {
                const text = item.innerText.toLowerCase();
                if (query === '' || text.includes(query)) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });
        }

